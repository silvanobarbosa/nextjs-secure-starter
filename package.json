{
  "name": "nextjs-secure-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "verify:doc-refs": "node scripts/verify-doc-refs.mjs",
    "verify:runtime-closure": "node scripts/verify-runtime-closure.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lhci": "npx --yes @lhci/cli@0.15 autorun",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.3",
    "@neondatabase/serverless": "^1.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^13.3.3",
    "@vercel/otel": "^2.1.0",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.0",
    "next": "^16.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@opentelemetry/api": "^1.9.0"
  }
}
