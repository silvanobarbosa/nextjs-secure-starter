# copie p/ .env.local e preencha
APP_NAME=my-app
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
SESSION_SECRET=troque-por-um-segredo-forte-de-32+-chars

# Sistema imunológico (optional, via env) (defesa runtime compartilhada) — opcional
IMMUNE_HUB_URL=https://example.com
IMMUNE_TOKEN=
IMMUNE_APP=

# ---- auth-kit (opcional, por app) ----
# Só preencha o que o app ligar em auth.config.ts. Método sem env é ignorado (não quebra).
# Núcleo (obrigatório se usar auth-kit):
BETTER_AUTH_SECRET=troque-por-segredo-forte-32+-chars
BETTER_AUTH_URL=http://localhost:3000
# URL pública p/ o client (browser) — normalmente = BETTER_AUTH_URL
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
# usa a mesma DATABASE_URL de cima (Postgres/Neon)

# OAuth social (só se ligar o método):
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# SSO (optional, via env) (Authentik — your-sso.example.com):
AUTHENTIK_ISSUER=https://your-sso.example.com/application/o/<slug>
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# E-mail (magic link / OTP / verificação). Ordem: Resend → gateway (optional, via env).
RESEND_API_KEY=
EMAIL_FROM=Acme <no-reply@example.com>

# Gateway de mensageria (optional, via env) (e-mail fallback + WhatsApp OTP):
MESSAGING_TOKEN=
MESSAGING_GATEWAY=https://example.com

# Passkey / WebAuthn (biometria):
PASSKEY_RP_ID=localhost

# Identidade do app (rpName, remetente, slug do gateway):
APP_NAME=my-app
APP_SLUG=my-app
